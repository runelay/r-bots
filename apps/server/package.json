{
  "name": "@runelay-bots/server",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env.local --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build --target=bun --bytecode --minify --sourcemap=linked src/index.ts --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "bun scripts/test-postgres.ts && bun test --coverage",
    "test:postgres": "bun scripts/test-postgres.ts",
    "migrate:sqlite": "bun scripts/migrate-sqlite-to-postgres.ts",
    "db:generate": "drizzle-kit generate && bun scripts/db-index.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.328",
    "@better-auth/api-key": "1.7.26",
    "@better-auth/passkey": "1.7.26",
    "@firecrawl/anydoc": "0.2.4",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@runelay-bots/protocol": "workspace:*",
    "@runelay-bots/providers": "workspace:*",
    "better-auth": "1.7.26",
    "bullmq": "5.81.5",
    "croner": "^11.0.1",
    "docx": "9.16.0",
    "drizzle-orm": "0.45.4",
    "exceljs": "4.4.0",
    "fast-formula-parser": "1.0.19",
    "marked": "18.2.1",
    "reflect-metadata": "0.2.2",
    "ulid": "^3.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11"
  }
}
