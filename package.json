{
  "name": "runelay-bots",
  "version": "0.1.2",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/server",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter @runelay-bots/server dev",
    "start": "bun --filter @runelay-bots/server start",
    "check": "biome check --write .",
    "lint": "biome lint --error-on-warnings .",
    "format": "biome format --write .",
    "typecheck": "bun --filter '*' typecheck",
    "test": "bun --filter '*' test",
    "migrate:legacy": "bun --filter @runelay-bots/server migrate:legacy"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/bun": "1.4.4",
    "typescript": "^7.0.2"
  }
}
