{
  "name": "runelay-bots",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "apps/server",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @runelay-bots/server",
    "start": "npm start -w @runelay-bots/server",
    "check": "biome check --write .",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "typescript": "^7.0.2"
  }
}
