# Copie para .env e ajuste. O docker compose lê este arquivo sozinho; o .env não é versionado.
# Segredos do servidor (RUNNER_TOKEN, chaves de API, S3) ficam no .env.local, não aqui.

# Dono dos arquivos no host. O usuário `app` da imagem é criado com este UID/GID.
BOTS_UID=1000
BOTS_GID=1000

# HOME do host. Daqui saem as credenciais montadas no HOME do container (/home/app):
# .claude, .claude.json, .codex, .config/gh, .supabase e .gitconfig.
HOST_HOME=/home/<seu-usuário>

# Pasta com os repositórios. É montada no mesmo caminho absoluto dentro do container,
# porque os worktrees do git guardam caminho absoluto.
PROJECTS_DIR=/home/<seu-usuário>/projects

# Pastas onde o modo código procura repositórios (separadas por vírgula). Padrão: PROJECTS_DIR.
CODE_REPO_ROOTS=/home/<seu-usuário>/projects

# Onde o modo código cria os worktrees. Também montado no mesmo caminho. Padrão: PROJECTS_DIR/worktrees.
CODE_WORKTREES_DIR=/home/<seu-usuário>/projects/worktrees

# Arquivo de segredos do servidor, montado só leitura. Padrão: ./.env.local.
BOTS_ENV_FILE=./.env.local

# Chave do cofre no host, montada só leitura. Padrão: HOST_HOME/.config/runelay-bots/vault.key.
VAULT_KEY_HOST_FILE=/home/<seu-usuário>/.config/runelay-bots/vault.key

# HOME do usuário do desktop virtual (perfis do Chrome). Vazio = volume do docker `desktop-home`.
# Se usar uma pasta do host, ela precisa pertencer ao UID 1501.
DESKTOP_HOME_DIR=

# Dados e backups. Padrão: ~/.local/share/runelay-bots e ~/.local/share/runelay-bots-backups.
# BOTS_DATA_DIR=
# BOTS_BACKUP_DIR=
# BOTS_STORAGE_DIR=

# Opcional: projeto com o supabase CLI linkado para a ferramenta de consulta em produção (só SELECT).
# Vazio = ferramenta desligada.
CONTY_API_DIR=

# Opcionais com padrão.
# GATEWAY_PORT=2000
# BOTS_SCHEDULES=on
# BOTS_CONTAINER_NAME=runelay-bots
# BOTS_IMAGE=runelay-bots-server:latest
# BOTS_MEM_LIMIT=6g
# BOTS_CPUS=3

# MAC_RUNNER_URL e PUBLIC_MCP_BASE (runner no Mac) vão no .env.local. Sem eles, o Mac só funciona
# pelo app conectado; o runner por HTTP fica desligado.
